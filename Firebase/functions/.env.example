# Server only. Never prefix a secret with VITE_ or include it in the APK.
FIREBASE_PROJECT_ID=driverguard-854e5
FIREBASE_STORAGE_BUCKET=driverguard-854e5.firebasestorage.app
ALLOWED_ORIGINS=https://driverguard-854e5.web.app,https://driverguard-854e5.firebaseapp.com,http://localhost:5173,http://127.0.0.1:5173
# In Render, set this secret to the full JSON from Firebase > Project settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=
# Server secret (service_role/secret key), never the public anon key, never VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENT_BUCKET=driver-documents
# Alternatively, for a trusted local admin terminal only:
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/driverguard-service-account.json
