# ==== Database (MySQL) ====
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/drowsiness_db

# ==== JWT / Auth ====
# Tạo secret key ngẫu nhiên, ví dụ lệnh: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60